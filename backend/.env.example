# Copy to .env. Everything has a safe development default.
DATABASE_URL=sqlite:///./noparking.db
STORAGE_DIR=./storage

# Leave ADMIN_PASSWORD empty and a random one is printed ONCE at first start.
# (Changing it here later does NOT change an existing account: use Dashboard > System > Change password.)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=

# THE REAL RULE: a violation only when parked for MORE THAN 900 seconds (15 minutes).
# DEMO MODE: set a short value such as 60. The dashboard then shows a yellow DEMO MODE banner.
VIOLATION_THRESHOLD_SECONDS=900
PRESENCE_GRACE_SECONDS=60
ANPR_CONFIDENCE_THRESHOLD=0.75

# Must equal WEB_TOKEN in the firmware config.h (used by the dashboard's live camera view)
CAM_VIEW_TOKEN=nopark-view-2026

SITE_LABEL=Main Gate No-Parking Zone
